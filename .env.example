# Personal AI Agent — environment variables
#
# Copy this file to .env.local and fill in real values. Never commit
# .env.local or paste real keys into chat, source control, or this file.

# --- Supabase (database + auth) -----------------------------------------
# From your Supabase project's Settings -> API Keys. Personal AI Agent uses
# Supabase's current publishable/secret key pair, not the legacy anon /
# service_role keys (both still work if that's what your project has --
# see README).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side only. Bypasses Row Level Security -- never send this to the
# browser, never prefix it with NEXT_PUBLIC_. Not read by any code in
# Phase 2 yet (all reads/writes go through the signed-in user's own
# session and RLS instead) -- documented here for the admin-style
# server operations a later phase will add.
SUPABASE_SECRET_KEY=

# --- App URL --------------------------------------------------------------
# Used to build the OAuth redirect URL for Google sign-in.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Real AI (Phase 2) ---------------------------------------------------
# Server-side only. Powers the /api/agent/chat route (real model calls +
# Gemini's built-in Google Search grounding tool). Without this set, the
# agent workspace shows a real "not configured" error instead of a fake
# reply. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Google Calendar OAuth (real, implemented) ---------------------------
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0
# Client ID (Web application). Powers "Continue with Google Calendar" on
# the Connections page — separate from "Continue with Google" sign-in,
# which only needs the Google provider enabled in your Supabase dashboard.
# Server-side only — never prefix any of these with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the OAuth client, e.g.
# https://<your-vercel-domain>/api/connections/google/calendar/callback
GOOGLE_REDIRECT_URI=
# Base64-encoded 32-byte key used to encrypt stored Google tokens at
# rest (AES-256-GCM, see lib/security/token-encryption.ts). Generate one
# with: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- Gmail, Drive, Tasks (not implemented) --------------------------------
# These still share the Google Workspace scopes but have no OAuth route
# or API calls behind them yet.

# --- GitHub connector ------------------------------------------------------
# Not implemented in Phase 2.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
